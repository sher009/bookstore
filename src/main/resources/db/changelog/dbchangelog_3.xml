<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Create Category Table -->
    <changeSet id="3" author="Cristian">
        <createTable tableName="category">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Create Category Id field in Book table -->
    <changeSet id="4" author="Cristian">
        <addColumn tableName="book">
            <column name="category_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <!-- Add Foreign Key for Category in Book Table -->
    <changeSet id="5" author="Cristian">
        <addForeignKeyConstraint
                constraintName="fk_book_category"
                baseTableName="book"
                baseColumnNames="category_id"
                referencedTableName="category"
                referencedColumnNames="id"
                onDelete="SET NULL"/>
    </changeSet>
</databaseChangeLog>
