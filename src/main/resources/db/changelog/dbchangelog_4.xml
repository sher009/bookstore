<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Creating a table for tags -->
    <changeSet id="6" author="Cristian">
        <createTable tableName="tag">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Creating a linked table between Book and Tag -->
    <changeSet id="7" author="Cristian" >
        <createTable  tableName="book_tags">
            <column name="book_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="tag_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Add a FOREIGN KEY for book_id -->
    <changeSet id="8" author="Cristian">
        <addForeignKeyConstraint
                baseTableName="book_tags" baseColumnNames="book_id"
                referencedTableName="book" referencedColumnNames="id"
                constraintName="fk_book_tags_book"
                onDelete="CASCADE"/>
    </changeSet>

    <!-- Add a FOREIGN KEY for tag_id -->
    <changeSet id="9" author="Cristian">
        <addForeignKeyConstraint
                baseTableName="book_tags" baseColumnNames="tag_id"
                referencedTableName="tag" referencedColumnNames="id"
                constraintName="fk_book_tags_tag"
                onDelete="CASCADE"/>
    </changeSet>

    <!-- Add a unique index to avoid duplicates in book_tags -->
    <changeSet id="10" author="Cristian">
        <addUniqueConstraint
                tableName="book_tags"
                columnNames="book_id, tag_id"
                constraintName="unique_book_tag"/>
    </changeSet>

</databaseChangeLog>
